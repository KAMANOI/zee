# Zee demo asset profile — generated by run_demo.sh, do not edit by hand.
#
# dry_run stays true: Zee's own safe default. With response_mode="auto"
# AND dry_run=true, a change-class decoy hit (write/rename/overwrite —
# exactly what the mock attacker does) resolves to mode=contain and logs
# + notifies "would cut" WITHOUT ever calling the real OS network-cut
# commands (see src/zee/responder/sequence.py step 4 — the dry_run branch
# never calls cut_egress/cut_full). This is what the demo records: the
# honest "detect → notify → would contain" story, with zero real risk to
# the recording machine's network. See demo/README.md for the separate,
# optional "auto + dry_run=false" scenario (a REAL network cut) and why
# it is not wired to run on this host.

dry_run = true

[[assets]]
id = "demo-victim-pc"
type = "workstation"
overnight_active = false
decoy_paths = [
    "__SANDBOX_DIR__/aws-credentials.decoy",
    "__SANDBOX_DIR__/.env",
]
response_mode = "auto"
cut_method = "egress"
