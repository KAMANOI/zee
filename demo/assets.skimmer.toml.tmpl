# Zee demo asset profile (JS-skimmer scenario) — generated by
# run_skimmer_demo.sh, do not edit by hand. Same safety posture as
# assets.demo.toml.tmpl: dry_run stays true + response_mode="auto", so a
# change-class decoy hit resolves to mode=contain and logs/notifies "would
# cut" WITHOUT ever calling the real OS network-cut commands. See
# demo/README.md and src/zee/responder/sequence.py (dry_run branch).
#
# Decoys model the Gambit (2026-09-22) file-layer surface: honeyfiles that
# look like the vendor JS an attacker would append a loader to, plus
# credential honeyfiles for the campaign's credential-hunting step.

dry_run = true

[[assets]]
id = "demo-ecom-webhost"
type = "workstation"
overnight_active = false
decoy_paths = [
    "__SANDBOX_DIR__/assets/js/jquery.min.js",
    "__SANDBOX_DIR__/assets/js/checkout.js",
    "__SANDBOX_DIR__/.env",
    "__SANDBOX_DIR__/aws-credentials.decoy",
]
response_mode = "auto"
cut_method = "egress"
