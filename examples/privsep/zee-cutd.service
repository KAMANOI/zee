# Zee cut daemon (privsep prototype) — docs/design/privsep.md
# Install as root: /etc/systemd/system/zee-cutd.service (root:root 0644).
# Replace WATCH_UID / WATCH_GROUP / WATCH_CONFIG with the user that runs
# `zee watch`. The code under /usr/local/lib/zee must be root-owned (0755 dirs, 0644 files).
[Unit]
Description=Zee cut daemon (privsep prototype)
After=network.target

[Service]
Type=simple
Environment=PYTHONPATH=/usr/local/lib/zee/src
# -P: never import from the working directory; -s: no user site-packages (root runs this)
ExecStart=/usr/bin/python3 -P -s -m zee privsep daemon --state-dir /var/lib/zee-cutd --socket /run/zee/cutd.sock --allow-uid WATCH_UID --group WATCH_GROUP --watch-config WATCH_CONFIG
# A signed `stop` exits 0 and must stay stopped; a crash restarts.
Restart=on-failure
RestartSec=2
RuntimeDirectory=zee
RuntimeDirectoryMode=0755
StateDirectory=zee-cutd
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
# openssl signature checks write temporary files: a private, writable /tmp
PrivateTmp=yes
ProtectHome=read-only
# The socket directory, and the iptables lock. iptables creates /run/xtables.lock
# on first use, which a read-only /run refuses (seen on the CI runner: restore was
# then unverifiable, Z606), so it is created before the sandbox applies ("+").
ExecStartPre=+/usr/bin/touch /run/xtables.lock
# "-": the namespace of ExecStartPre itself is set up before the file exists (systemd 255)
ReadWritePaths=/run/zee -/run/xtables.lock

[Install]
WantedBy=multi-user.target
